---
// Subtle floating particles - neutral colors
---

<div class="floating-elements" aria-hidden="true">
  <!-- Subtle particles -->
  <div class="particle particle--1"></div>
  <div class="particle particle--2"></div>
  <div class="particle particle--3"></div>
  <div class="particle particle--4"></div>
  <div class="particle particle--5"></div>
</div>

<style>
  .floating-elements {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  /* Subtle particles */
  .particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
  }

  .particle--1 {
    top: 20%;
    left: 15%;
    animation: particle-float 15s ease-in-out infinite;
  }

  .particle--2 {
    top: 40%;
    right: 25%;
    animation: particle-float 18s ease-in-out infinite 2s;
  }

  .particle--3 {
    bottom: 30%;
    left: 30%;
    animation: particle-float 12s ease-in-out infinite 4s;
  }

  .particle--4 {
    top: 60%;
    right: 15%;
    animation: particle-float 20s ease-in-out infinite 1s;
  }

  .particle--5 {
    bottom: 15%;
    left: 60%;
    animation: particle-float 16s ease-in-out infinite 3s;
  }

  @keyframes particle-float {
    0%, 100% {
      transform: translate(0, 0);
      opacity: 0.2;
    }
    50% {
      transform: translate(30px, -40px);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .particle {
      animation: none;
    }
  }
</style>
