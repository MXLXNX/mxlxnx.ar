---
interface Props {
  color?: 'pink' | 'blue' | 'green' | 'purple' | 'yellow' | 'coral';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'center';
  blur?: boolean;
  className?: string;
}

const {
  color = 'pink',
  size = 'md',
  position = 'top-right',
  blur = true,
  className = ''
} = Astro.props;

const colorMap = {
  pink: 'var(--color-pink)',
  blue: 'var(--color-blue)',
  green: 'var(--color-neon-green)',
  purple: 'var(--color-purple-light)',
  yellow: 'var(--color-yellow)',
  coral: 'var(--color-coral)'
};

const sizeMap = {
  sm: '150px',
  md: '300px',
  lg: '450px',
  xl: '600px'
};

const positionStyles = {
  'top-left': 'top: -10%; left: -10%;',
  'top-right': 'top: -10%; right: -10%;',
  'bottom-left': 'bottom: -10%; left: -10%;',
  'bottom-right': 'bottom: -10%; right: -10%;',
  'center': 'top: 50%; left: 50%; transform: translate(-50%, -50%);'
};
---

<div
  class:list={['blob', `blob--${size}`, `blob--${position}`, { 'blob--blur': blur }, className]}
  style={`--blob-color: ${colorMap[color]}; --blob-size: ${sizeMap[size]};`}
  aria-hidden="true"
></div>

<style>
  .blob {
    position: absolute;
    width: var(--blob-size);
    height: var(--blob-size);
    background: var(--blob-color);
    opacity: 0.4;
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    animation: blob-morph 8s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }

  .blob--blur {
    filter: blur(60px);
  }

  /* Sizes */
  .blob--sm { --blob-size: 150px; }
  .blob--md { --blob-size: 300px; }
  .blob--lg { --blob-size: 450px; }
  .blob--xl { --blob-size: 600px; }

  /* Positions */
  .blob--top-left {
    top: -10%;
    left: -10%;
  }

  .blob--top-right {
    top: -10%;
    right: -10%;
  }

  .blob--bottom-left {
    bottom: -10%;
    left: -10%;
  }

  .blob--bottom-right {
    bottom: -10%;
    right: -10%;
  }

  .blob--center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  /* Different animation delays for variety */
  .blob:nth-of-type(2) {
    animation-delay: -2s;
  }

  .blob:nth-of-type(3) {
    animation-delay: -4s;
  }

  @keyframes blob-morph {
    0%, 100% {
      border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
    25% {
      border-radius: 70% 30% 50% 50% / 30% 30% 70% 70%;
      transform: translate(10px, -10px) rotate(5deg) scale(1.05);
    }
    50% {
      border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%;
      transform: translate(-5px, 15px) rotate(-5deg) scale(0.95);
    }
    75% {
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
      transform: translate(5px, 5px) rotate(3deg) scale(1.02);
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }
</style>
