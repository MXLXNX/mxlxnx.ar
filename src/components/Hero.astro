---
interface Props {
  title?: string;
  subtitle?: string;
  name?: string;
}

const {
  title = "MXLXNX",
  subtitle = "Creative & Multidisciplinary Artist",
  name = "Malena Posadas"
} = Astro.props;
---

<section class="hero" id="hero">
  <div class="hero__bg">
    <div class="hero__flash-layer" data-flash-layer></div>
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content">
    <!-- Main Title - MXLXNX -->
    <div class="hero__title-wrapper">
      <h1 class="hero__title">{title}</h1>
    </div>

    <!-- Name -->
    <p class="hero__name">{name}</p>

    <!-- Subtitle -->
    <p class="hero__subtitle">{subtitle}</p>

    <!-- CTAs -->
    <div class="hero__actions">
      <a href="#f1-visuals" class="hero__btn hero__btn--primary">
        <span>View Work</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="#contact" class="hero__btn hero__btn--outline">
        <span>Contact</span>
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="hero__scroll">
      <span class="hero__scroll-text">Scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-black);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgb(10, 10, 10);
  }

  .hero__flash-layer {
    position: absolute;
    inset: 0;
    background: rgb(10, 10, 10);
    opacity: 0.5;
    transition: background-color 0.05s ease-out, opacity 0.1s ease-out;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.15) 30%,
      rgba(0, 0, 0, 0.3) 60%,
      rgba(10, 10, 10, 0.8) 85%,
      rgb(10, 10, 10) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-4xl) var(--space-lg);
    width: 100%;
    max-width: 1400px;
  }

  .hero__title-wrapper {
    position: relative;
    margin-bottom: var(--space-xl);
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero__title {
    font-family: 'Archivo Black', var(--font-display);
    font-size: clamp(3rem, 14vw, 10rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--color-white);
    margin: 0;
  }

  .hero__name {
    font-family: 'Inter', var(--font-sans);
    font-size: var(--text-xl);
    font-weight: 300;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--color-white);
    margin-bottom: var(--space-md);
    text-shadow: 0 2px 20px rgba(0,0,0,0.8);
    opacity: 0.95;
  }

  .hero__subtitle {
    font-family: 'Inter', var(--font-sans);
    font-size: var(--text-base);
    font-weight: 300;
    color: rgba(255,255,255,0.8);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    max-width: 600px;
    margin-bottom: var(--space-3xl);
    text-shadow: 0 2px 15px rgba(0,0,0,0.7);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: var(--space-4xl);
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: var(--space-md) var(--space-2xl);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .hero__btn--primary {
    background: var(--color-white);
    color: var(--color-black);
    border: none;
    font-weight: 700;
  }

  .hero__btn--primary:hover {
    background: var(--color-gray-200);
    transform: translateY(-3px);
    box-shadow: 0 10px 40px rgba(255, 255, 255, 0.3);
  }

  .hero__btn--outline {
    background: transparent;
    color: var(--color-white);
    border: 2px solid rgba(255,255,255,0.5);
  }

  .hero__btn--outline:hover {
    border-color: var(--color-white);
    background: rgba(255,255,255,0.1);
    transform: translateY(-3px);
  }

  .hero__scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .hero__scroll-text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
  }

  .hero__scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.6), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 1; height: 60px; }
    50% { opacity: 0.3; height: 40px; }
  }

  @media (max-width: 810px) {
    .hero__title {
      font-size: clamp(2.5rem, 12vw, 6rem);
      -webkit-text-stroke: none;
    }

    .hero__name {
      font-size: var(--text-sm);
      letter-spacing: 0.25em;
    }

    .hero__subtitle {
      font-size: var(--text-xs);
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line {
      animation: none;
    }
    .hero__flash-layer {
      opacity: 0 !important;
    }
  }
</style>

<script>
  const flashLayer = document.querySelector('[data-flash-layer]') as HTMLElement;

  if (flashLayer) {
    const colors = [
      { bg: '#000000', opacity: 0.9 },   // black
      { bg: '#ffffff', opacity: 0.4 },   // white flash
      { bg: '#000000', opacity: 0.8 },   // black
      { bg: '#ff1744', opacity: 0.35 },  // red
      { bg: '#0a0a0a', opacity: 0.9 },   // dark
      { bg: '#ff4081', opacity: 0.3 },   // pink
      { bg: '#000000', opacity: 0.85 },  // black
      { bg: '#2979ff', opacity: 0.3 },   // blue
      { bg: '#0a0a0a', opacity: 0.9 },   // dark
      { bg: '#ffffff', opacity: 0.5 },   // white flash
      { bg: '#000000', opacity: 0.9 },   // black
      { bg: '#e040fb', opacity: 0.25 },  // purple
      { bg: '#0a0a0a', opacity: 0.85 },  // dark
      { bg: '#ff6e40', opacity: 0.3 },   // orange
      { bg: '#000000', opacity: 0.9 },   // black
      { bg: '#00e5ff', opacity: 0.25 },  // cyan
    ];

    let currentIndex = 0;
    let nextFlashTime = 0;
    let isFlashing = false;

    function getRandomInterval() {
      // Random intervals between 80ms and 400ms for unpredictable rhythm
      return Math.random() * 320 + 80;
    }

    function getFlashDuration() {
      // Flash duration between 30ms and 120ms
      return Math.random() * 90 + 30;
    }

    function flash() {
      const now = performance.now();

      if (now >= nextFlashTime) {
        if (!isFlashing) {
          // Start flash
          const color = colors[currentIndex];
          flashLayer.style.backgroundColor = color.bg;
          flashLayer.style.opacity = String(color.opacity);
          isFlashing = true;
          nextFlashTime = now + getFlashDuration();
          currentIndex = (currentIndex + 1) % colors.length;
        } else {
          // End flash - return to dark
          flashLayer.style.backgroundColor = '#0a0a0a';
          flashLayer.style.opacity = '0.6';
          isFlashing = false;
          nextFlashTime = now + getRandomInterval();
        }
      }

      requestAnimationFrame(flash);
    }

    // Start with a slight delay
    setTimeout(() => {
      nextFlashTime = performance.now() + 500;
      flash();
    }, 100);
  }
</script>
