---
import Blob from './Blob.astro';
import Button from './Button.astro';
import AnimatedSection from './AnimatedSection.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const content = {
  en: {
    eyebrow: 'Get in Touch',
    title: "Let's Make Something Truly Special",
    description: "Have a vision that needs to come alive? I'm here to listen. Let's explore the possibilities together.",
    form: {
      name: 'Your Name',
      email: 'Your Email',
      message: 'Tell me about your vision...',
      submit: 'Send Message'
    },
    alternative: 'Or reach me directly at'
  },
  es: {
    eyebrow: 'Contacto',
    title: 'Creemos Algo Especial',
    description: '¿Tenés una visión que necesita cobrar vida? Estoy acá para escucharte. Exploremos las posibilidades juntos.',
    form: {
      name: 'Tu Nombre',
      email: 'Tu Email',
      message: 'Contame sobre tu visión...',
      submit: 'Enviar Mensaje'
    },
    alternative: 'O escribime directamente a'
  },
  fr: {
    eyebrow: 'Contact',
    title: 'Créons Quelque Chose de Spécial',
    description: 'Vous avez une vision qui doit prendre vie ? Je suis là pour écouter. Explorons les possibilités ensemble.',
    form: {
      name: 'Votre Nom',
      email: 'Votre Email',
      message: 'Parlez-moi de votre vision...',
      submit: 'Envoyer le Message'
    },
    alternative: 'Ou contactez-moi directement à'
  },
  de: {
    eyebrow: 'Kontakt',
    title: 'Lass Uns Etwas Besonderes Erschaffen',
    description: 'Haben Sie eine Vision, die zum Leben erweckt werden muss? Ich bin hier, um zuzuhören. Lassen Sie uns die Möglichkeiten gemeinsam erkunden.',
    form: {
      name: 'Ihr Name',
      email: 'Ihre Email',
      message: 'Erzählen Sie mir von Ihrer Vision...',
      submit: 'Nachricht Senden'
    },
    alternative: 'Oder erreichen Sie mich direkt unter'
  },
  pt: {
    eyebrow: 'Contato',
    title: 'Vamos Criar Algo Especial',
    description: 'Tem uma visão que precisa ganhar vida? Estou aqui para ouvir. Vamos explorar as possibilidades juntos.',
    form: {
      name: 'Seu Nome',
      email: 'Seu Email',
      message: 'Conte-me sobre sua visão...',
      submit: 'Enviar Mensagem'
    },
    alternative: 'Ou me contate diretamente em'
  },
  ja: {
    eyebrow: 'お問い合わせ',
    title: '特別なものを一緒に創りましょう',
    description: '実現したいビジョンがありますか？お聞かせください。一緒に可能性を探求しましょう。',
    form: {
      name: 'お名前',
      email: 'メールアドレス',
      message: 'あなたのビジョンについて教えてください...',
      submit: 'メッセージを送信'
    },
    alternative: '直接のご連絡はこちらへ'
  },
  ar: {
    eyebrow: 'تواصل معي',
    title: 'لنصنع شيئاً مميزاً',
    description: 'هل لديك رؤية تحتاج أن تتحقق؟ أنا هنا للاستماع. لنستكشف الإمكانيات معاً.',
    form: {
      name: 'اسمك',
      email: 'بريدك الإلكتروني',
      message: 'أخبرني عن رؤيتك...',
      submit: 'إرسال الرسالة'
    },
    alternative: 'أو تواصل معي مباشرة على'
  }
};

const t = content[lang as keyof typeof content] || content.en;
---

<section class="contact section" id="contact">
  <div class="contact__video-bg">
    <video autoplay muted loop playsinline>
      <source src="/videos/social_thelaundryman_a_vast_surreal_seascape_where_light_and_darknes_8569d003-1c27-49bf-b952-aad57224b48e_0.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="contact__background">
    <Blob color="coral" size="xl" position="top-left" />
    <Blob color="yellow" size="lg" position="bottom-right" />
  </div>

  <div class="contact__container container">
    <AnimatedSection animation="fade-up" className="contact__header">
      <span class="contact__eyebrow">{t.eyebrow}</span>
      <h2 class="contact__title">{t.title}</h2>
      <p class="contact__description">{t.description}</p>
    </AnimatedSection>

    <AnimatedSection animation="fade-up" delay={200} className="contact__form-wrapper">
      <form class="contact__form" action="https://formspree.io/f/xpwvrgov" method="POST">

        <div class="contact__field">
          <label for="name" class="sr-only">{t.form.name}</label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder={t.form.name}
            required
            class="contact__input"
          />
        </div>

        <div class="contact__field">
          <label for="email" class="sr-only">{t.form.email}</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder={t.form.email}
            required
            class="contact__input"
          />
        </div>

        <div class="contact__field contact__field--full">
          <label for="message" class="sr-only">{t.form.message}</label>
          <textarea
            id="message"
            name="message"
            placeholder={t.form.message}
            rows="5"
            required
            class="contact__textarea"
          ></textarea>
        </div>

        <div class="contact__submit">
          <Button variant="primary" size="lg" type="submit" fullWidth>
            {t.form.submit}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </Button>
        </div>
      </form>
    </AnimatedSection>

    <!-- Alternative contact -->
    <AnimatedSection animation="fade-up" delay={400} className="contact__alternative">
      <p class="contact__alternative-text">{t.alternative}</p>
      <a href="mailto:m@mxlxnx.com" class="contact__email">m@mxlxnx.com</a>
    </AnimatedSection>
  </div>
</section>

<style>
  .contact {
    position: relative;
    background: var(--color-black);
    overflow: hidden;
  }

  .contact__video-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .contact__video-bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  .contact__video-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.75);
  }

  .contact__background {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    z-index: 1;
  }

  .contact__container {
    position: relative;
    z-index: 2;
    max-width: 700px;
  }

  .contact__header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .contact__eyebrow {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-gray-400);
    margin-bottom: var(--space-md);
  }

  .contact__title {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    color: var(--color-white);
    margin-bottom: var(--space-lg);
  }

  .contact__description {
    font-size: var(--text-lg);
    color: var(--color-gray-400);
    max-width: 500px;
    margin: 0 auto;
  }

  /* Form */
  .contact__form-wrapper {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
  }

  .contact__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  @media (max-width: 538px) {
    .contact__form {
      grid-template-columns: 1fr;
    }
  }

  .contact__field--full {
    grid-column: 1 / -1;
  }

  .contact__input,
  .contact__textarea {
    width: 100%;
    padding: var(--space-md) var(--space-lg);
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
    outline: none;
  }

  .contact__input::placeholder,
  .contact__textarea::placeholder {
    color: var(--color-gray-500);
  }

  .contact__input:focus,
  .contact__textarea:focus {
    border-color: var(--color-blue);
    box-shadow: 0 0 0 3px rgba(0, 153, 255, 0.2);
  }

  .contact__textarea {
    resize: vertical;
    min-height: 150px;
  }

  .contact__submit {
    grid-column: 1 / -1;
    margin-top: var(--space-md);
  }

  .contact__submit :global(.btn) {
    background: transparent !important;
    color: var(--color-white) !important;
    font-weight: 500;
    padding: 1rem 2rem;
    border: 1px solid rgba(255, 255, 255, 0.4) !important;
    border-radius: 4px;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }

  .contact__submit :global(.btn:hover) {
    background: var(--color-white) !important;
    color: var(--color-black) !important;
    border-color: var(--color-white) !important;
  }

  /* Alternative contact */
  .contact__alternative {
    text-align: center;
    margin-top: var(--space-3xl);
  }

  .contact__alternative-text {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    margin-bottom: var(--space-sm);
  }

  .contact__email {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-style: italic;
    color: var(--color-white);
    text-decoration: none;
    position: relative;
    transition: color var(--transition-fast);
  }

  .contact__email::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-white);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--transition-base);
  }

  .contact__email:hover {
    color: var(--color-gray-300);
  }

  .contact__email:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  </style>

<script>
  // Form submission handling with Formspree
  const form = document.querySelector('.contact__form') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const button = form.querySelector('button[type="submit"]');
    const originalText = button?.textContent || 'Send Message';

    if (button) {
      button.setAttribute('disabled', 'true');
      button.textContent = 'Sending...';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });

      if (response.ok) {
        // Success state
        if (button) {
          button.textContent = 'Sent! ✓';
          button.classList.add('success');
        }
        form.reset();

        setTimeout(() => {
          if (button) {
            button.removeAttribute('disabled');
            button.textContent = originalText;
            button.classList.remove('success');
          }
        }, 3000);
      } else {
        throw new Error('Form submission failed');
      }

    } catch (error) {
      if (button) {
        button.textContent = 'Error - Try again';
        setTimeout(() => {
          button.removeAttribute('disabled');
          button.textContent = originalText;
        }, 2000);
      }
    }
  });
</script>
