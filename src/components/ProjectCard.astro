---
interface Props {
  title: string;
  description?: string;
  thumbnail?: string;
  video?: string;
  category: 'brands' | 'own-ideas' | 'f1-visuals';
  accentColor?: string;
  href: string;
  index?: number;
}

const {
  title,
  description,
  thumbnail = '/images/placeholder.jpg',
  video,
  category,
  accentColor = '#fc9191',
  href,
  index = 0
} = Astro.props;

const categoryLabels = {
  'brands': 'Brands',
  'own-ideas': 'Own Ideas',
  'f1-visuals': 'F1 Visuals'
};

const categoryColors = {
  'brands': '#ff2d92',
  'own-ideas': '#00d4ff',
  'f1-visuals': '#00ff88'
};

const color = accentColor || categoryColors[category];
---

<article
  class="project-card"
  data-category={category}
  data-color={color}
  style={`--accent-color: ${color}; animation-delay: ${index * 100}ms;`}
  data-animate="fade-up"
>
  <a href={href} class="project-card__link">
    <div class="project-card__media">
      {video ? (
        <video
          class="project-card__video"
          src={video}
          muted
          loop
          playsinline
          preload="metadata"
        />
      ) : (
        <img
          class="project-card__image"
          src={thumbnail}
          alt={title}
          loading="lazy"
        />
      )}
      <div class="project-card__overlay"></div>
      <div class="project-card__glow"></div>
    </div>

    <div class="project-card__content">
      <span class="project-card__category">{categoryLabels[category]}</span>
      <h3 class="project-card__title">{title}</h3>
      {description && (
        <p class="project-card__description">{description}</p>
      )}
    </div>

    <div class="project-card__arrow">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </a>
</article>

<style>
  .project-card {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-gray-900);
    transition: transform var(--transition-base);
  }

  .project-card:hover {
    transform: translateY(-8px);
  }

  .project-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-card__media {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: #0a0a0a;
  }

  .project-card__image,
  .project-card__video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--transition-slow);
  }

  .project-card:hover .project-card__image,
  .project-card:hover .project-card__video {
    transform: scale(1.05);
  }

  .project-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.2) 50%,
      transparent 100%
    );
    opacity: 0.8;
    transition: opacity var(--transition-base);
  }

  .project-card:hover .project-card__overlay {
    opacity: 0.6;
  }

  /* Dynamic glow effect based on accent color */
  .project-card__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      var(--accent-color) 0%,
      transparent 70%
    );
    opacity: 0;
    mix-blend-mode: overlay;
    transition: opacity var(--transition-base);
  }

  .project-card:hover .project-card__glow {
    opacity: 0.4;
  }

  .project-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-lg);
    z-index: 1;
  }

  .project-card__category {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-color);
    margin-bottom: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    background: rgba(0, 0, 0, 0.5);
    border-radius: var(--radius-sm);
  }

  .project-card__title {
    font-family: var(--font-accent);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--color-white);
    margin-bottom: var(--space-xs);
    transition: color var(--transition-fast);
    letter-spacing: 0.05em;
  }

  .project-card:hover .project-card__title {
    color: var(--accent-color);
  }

  .project-card__description {
    font-size: var(--text-sm);
    color: var(--color-gray-400);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .project-card__arrow {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-full);
    color: var(--color-white);
    opacity: 0;
    transform: translateY(-10px);
    transition: all var(--transition-base);
  }

  .project-card:hover .project-card__arrow {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card__arrow:hover {
    background: var(--accent-color);
    color: var(--color-black);
  }
</style>

<script>
  // Video hover play
  document.querySelectorAll('.project-card').forEach(card => {
    const video = card.querySelector('.project-card__video') as HTMLVideoElement;

    if (video) {
      card.addEventListener('mouseenter', () => {
        video.play().catch(() => {});
      });

      card.addEventListener('mouseleave', () => {
        video.pause();
        video.currentTime = 0;
      });
    }
  });

  // Color immersion effect - changes page background on hover
  document.querySelectorAll('.project-card').forEach(card => {
    const color = card.getAttribute('data-color');
    const body = document.body;

    card.addEventListener('mouseenter', () => {
      body.style.setProperty('--immersion-color', color || '#000');
      body.classList.add('has-immersion');
    });

    card.addEventListener('mouseleave', () => {
      body.classList.remove('has-immersion');
    });
  });
</script>

<style is:global>
  /* Global immersion effect */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      var(--immersion-color, transparent) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: -1;
  }

  body.has-immersion::before {
    opacity: 0.15;
  }
</style>
