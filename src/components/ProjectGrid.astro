---
import ProjectCard from './ProjectCard.astro';
import AnimatedSection from './AnimatedSection.astro';

interface Project {
  title: string;
  description?: string;
  thumbnail?: string;
  video?: string;
  category: 'brands' | 'own-ideas' | 'f1-visuals';
  accentColor?: string;
  href: string;
}

interface Props {
  projects: Project[];
  lang?: string;
  showFilters?: boolean;
  sectionTitle?: string;
  sectionSubtitle?: string;
  variant?: 'dark' | 'accent';
  effect?: 'none' | 'sand' | 'flash';
}

const { projects, lang = 'en', showFilters = true, sectionTitle, sectionSubtitle, variant = 'dark', effect = 'none' } = Astro.props;

const content = {
  en: {
    eyebrow: 'Selected Work',
    title: 'Projects',
    subtitle: 'I build strong characters. I find personalities that grab you and don\'t let go.',
    filters: {
      all: 'All',
      brands: 'Brands',
      'own-ideas': 'Own Ideas',
      'f1-visuals': 'F1 Visuals'
    }
  },
  es: {
    eyebrow: 'Trabajo Seleccionado',
    title: 'Proyectos',
    subtitle: 'Armo personajes fuertes. Encuentro personalidades que te atrapan y no te sueltan.',
    filters: {
      all: 'Todos',
      brands: 'Marcas',
      'own-ideas': 'Ideas Propias',
      'f1-visuals': 'Visuales F1'
    }
  }
};

const t = content[lang as keyof typeof content] || content.en;

const categories = ['all', 'brands', 'own-ideas', 'f1-visuals'] as const;
---

<section class:list={['projects', 'section', variant === 'accent' && 'projects--accent', effect === 'sand' && 'projects--sand', effect === 'flash' && 'projects--flash']} data-effect={effect}>
  {effect === 'sand' && <canvas class="sand-canvas" data-sand-canvas></canvas>}
  <div class="projects__container container">
    <AnimatedSection animation="fade-up" className="projects__header">
      <span class="projects__eyebrow">{sectionTitle || t.eyebrow}</span>
      <h2 class="projects__title">{sectionTitle || t.title}</h2>
      <p class="projects__subtitle">{sectionSubtitle || t.subtitle}</p>
    </AnimatedSection>

    {showFilters && (
      <AnimatedSection animation="fade-up" delay={100} className="projects__filters">
        <div class="projects__filter-list" role="tablist">
          {categories.map((cat, i) => (
            <button
              class:list={['projects__filter', { 'is-active': cat === 'all' }]}
              data-filter={cat}
              role="tab"
              aria-selected={cat === 'all'}
            >
              {t.filters[cat as keyof typeof t.filters]}
            </button>
          ))}
        </div>
      </AnimatedSection>
    )}

    <div class="projects__grid" data-stagger>
      {projects.map((project, index) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          thumbnail={project.thumbnail}
          video={project.video}
          category={project.category}
          accentColor={project.accentColor}
          href={project.href}
          index={index}
        />
      ))}
    </div>

    <!-- Empty state -->
    <div class="projects__empty" hidden>
      <p>No projects found in this category.</p>
    </div>
  </div>
</section>

<style>
  .projects {
    background: linear-gradient(180deg,
      rgb(10, 10, 10) 0%,
      rgba(10, 10, 10, 0.98) 2%,
      #12101a 10%,
      #181220 35%,
      #1a1018 55%,
      #120a15 80%,
      #0d0a12 92%,
      rgba(10, 10, 10, 0.98) 98%,
      rgb(10, 10, 10) 100%
    );
    position: relative;
  }

  .projects::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(ellipse at 20% 30%, rgba(150, 50, 255, 0.10) 0%, transparent 45%),
      radial-gradient(ellipse at 80% 70%, rgba(255, 50, 150, 0.08) 0%, transparent 45%);
    pointer-events: none;
  }

  .projects--accent {
    background: linear-gradient(180deg,
      rgb(10, 10, 10) 0%,
      rgba(10, 10, 10, 0.98) 2%,
      #14081a 8%,
      #18081a 15%,
      #1a1020 35%,
      #100a18 55%,
      #0a1212 75%,
      #0f0a15 88%,
      #0c0810 95%,
      rgba(10, 10, 10, 0.98) 98%,
      rgb(10, 10, 10) 100%
    );
    position: relative;
  }

  .projects--accent::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(ellipse at 25% 25%, rgba(255, 0, 150, 0.12) 0%, transparent 50%),
      radial-gradient(ellipse at 75% 50%, rgba(100, 0, 255, 0.10) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 80%, rgba(0, 255, 150, 0.06) 0%, transparent 40%);
    pointer-events: none;
  }

  .projects--accent .projects__eyebrow {
    color: var(--color-gray-400);
  }

  .projects--accent .projects__title {
    color: var(--color-white);
  }

  .projects--accent .projects__subtitle {
    color: var(--color-gray-400);
  }

  .projects__container {
    position: relative;
  }

  .projects__header {
    text-align: center;
    margin-bottom: var(--space-4xl);
    padding: 0 var(--space-xl);
  }

  .projects__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--color-gray-500);
    margin-bottom: var(--space-lg);
    transform: rotate(-1deg);
  }

  .projects__title {
    font-family: var(--font-accent);
    font-size: var(--text-6xl);
    color: var(--color-white);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-xl);
    text-shadow: 0 0 80px rgba(180, 0, 255, 0.2);
  }

  .projects__subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    color: var(--color-gray-300);
    max-width: 900px;
    margin: 0 auto;
    line-height: 1.8;
    letter-spacing: 0.02em;
  }

  /* Filters */
  .projects__filters {
    margin-bottom: var(--space-3xl);
  }

  .projects__filter-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }

  .projects__filter {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-sm) var(--space-lg);
    background: transparent;
    color: var(--color-gray-400);
    border: 1px solid var(--color-gray-700);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .projects__filter:hover {
    color: var(--color-white);
    border-color: var(--color-gray-500);
  }

  .projects__filter.is-active {
    background: var(--color-black);
    color: var(--color-white);
    border-color: var(--color-black);
  }

  /* Grid */
  .projects__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 538px) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Empty state */
  .projects__empty {
    text-align: center;
    padding: var(--space-4xl);
    color: var(--color-gray-500);
  }

  .projects__empty[hidden] {
    display: none;
  }

  /* Filter animation for cards */
  :global(.project-card) {
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  :global(.project-card.is-hidden) {
    opacity: 0;
    transform: scale(0.9);
    pointer-events: none;
    position: absolute;
  }

  /* Sand effect for SILENTIA */
  .projects--sand {
    position: relative;
    overflow: hidden;
  }

  .projects--sand .sand-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .projects--sand .projects__container {
    position: relative;
    z-index: 1;
  }

  /* Flash effect for Moods */
  .projects--flash {
    position: relative;
  }

  .projects--flash::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0);
    pointer-events: none;
    z-index: 10;
    animation: flash-strobe 4s infinite;
  }

  @keyframes flash-strobe {
    0%, 94%, 100% {
      background: rgba(255, 255, 255, 0);
    }
    95% {
      background: rgba(255, 255, 255, 0.15);
    }
    96% {
      background: rgba(255, 255, 255, 0);
    }
    97% {
      background: rgba(255, 255, 255, 0.1);
    }
    98% {
      background: rgba(255, 255, 255, 0);
    }
  }
</style>

<script>
  const filterButtons = document.querySelectorAll('.projects__filter');
  const projectCards = document.querySelectorAll('.project-card');
  const emptyState = document.querySelector('.projects__empty');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');

      // Update active state
      filterButtons.forEach(btn => {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-selected', 'false');
      });
      button.classList.add('is-active');
      button.setAttribute('aria-selected', 'true');

      // Filter cards
      let visibleCount = 0;

      projectCards.forEach(card => {
        const category = card.getAttribute('data-category');
        const shouldShow = filter === 'all' || category === filter;

        if (shouldShow) {
          card.classList.remove('is-hidden');
          visibleCount++;
        } else {
          card.classList.add('is-hidden');
        }
      });

      // Show/hide empty state
      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    });
  });

  // Sand animation for SILENTIA section
  const sandCanvas = document.querySelector('[data-sand-canvas]') as HTMLCanvasElement;
  if (sandCanvas) {
    const ctx = sandCanvas.getContext('2d');
    const parent = sandCanvas.parentElement;

    interface SandParticle {
      x: number;
      y: number;
      size: number;
      speedX: number;
      speedY: number;
      opacity: number;
      type: 'grain' | 'dust' | 'wisp';
      wobble: number;
      wobbleSpeed: number;
      color: string;
    }

    const particles: SandParticle[] = [];
    const particleCount = 400;
    let time = 0;
    let windStrength = 1;
    let windTarget = 1;

    const colors = [
      '210, 180, 140',  // tan
      '220, 190, 150',  // light sand
      '200, 170, 130',  // dark sand
      '230, 200, 160',  // cream
      '190, 160, 120',  // brown sand
      '240, 220, 180',  // golden
    ];

    function resizeCanvas() {
      if (parent && sandCanvas) {
        sandCanvas.width = parent.offsetWidth;
        sandCanvas.height = parent.offsetHeight;
      }
    }

    function createParticles() {
      particles.length = 0;

      // Small grains - lots of them
      for (let i = 0; i < particleCount * 0.6; i++) {
        particles.push({
          x: Math.random() * sandCanvas.width,
          y: Math.random() * sandCanvas.height,
          size: Math.random() * 1.5 + 0.5,
          speedX: Math.random() * 1.2 + 0.3,
          speedY: Math.random() * 0.4 - 0.2,
          opacity: Math.random() * 0.3 + 0.1,
          type: 'grain',
          wobble: Math.random() * Math.PI * 2,
          wobbleSpeed: Math.random() * 0.02 + 0.01,
          color: colors[Math.floor(Math.random() * colors.length)]
        });
      }

      // Medium dust particles
      for (let i = 0; i < particleCount * 0.3; i++) {
        particles.push({
          x: Math.random() * sandCanvas.width,
          y: Math.random() * sandCanvas.height,
          size: Math.random() * 3 + 2,
          speedX: Math.random() * 0.8 + 0.2,
          speedY: Math.random() * 0.3 - 0.15,
          opacity: Math.random() * 0.15 + 0.05,
          type: 'dust',
          wobble: Math.random() * Math.PI * 2,
          wobbleSpeed: Math.random() * 0.015 + 0.005,
          color: colors[Math.floor(Math.random() * colors.length)]
        });
      }

      // Large soft wisps - few but atmospheric
      for (let i = 0; i < particleCount * 0.1; i++) {
        particles.push({
          x: Math.random() * sandCanvas.width,
          y: Math.random() * sandCanvas.height,
          size: Math.random() * 40 + 20,
          speedX: Math.random() * 0.4 + 0.1,
          speedY: Math.random() * 0.2 - 0.1,
          opacity: Math.random() * 0.04 + 0.01,
          type: 'wisp',
          wobble: Math.random() * Math.PI * 2,
          wobbleSpeed: Math.random() * 0.008 + 0.002,
          color: colors[Math.floor(Math.random() * 3)]
        });
      }
    }

    function animateSand() {
      if (!ctx) return;
      ctx.clearRect(0, 0, sandCanvas.width, sandCanvas.height);

      time += 0.016;

      // Slowly change wind
      if (Math.random() < 0.01) {
        windTarget = 0.5 + Math.random() * 1;
      }
      windStrength += (windTarget - windStrength) * 0.01;

      particles.forEach(p => {
        p.wobble += p.wobbleSpeed;
        const wobbleOffset = Math.sin(p.wobble) * (p.type === 'wisp' ? 2 : 0.5);

        p.x += p.speedX * windStrength;
        p.y += p.speedY + wobbleOffset * 0.1;

        // Reset particles that go off screen
        if (p.x > sandCanvas.width + p.size) {
          p.x = -p.size * 2;
          p.y = Math.random() * sandCanvas.height;
        }
        if (p.y < -p.size) p.y = sandCanvas.height + p.size;
        if (p.y > sandCanvas.height + p.size) p.y = -p.size;

        // Draw based on type
        if (p.type === 'grain') {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${p.color}, ${p.opacity})`;
          ctx.fill();
        } else if (p.type === 'dust') {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          const gradient = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size);
          gradient.addColorStop(0, `rgba(${p.color}, ${p.opacity})`);
          gradient.addColorStop(1, `rgba(${p.color}, 0)`);
          ctx.fillStyle = gradient;
          ctx.fill();
        } else if (p.type === 'wisp') {
          const gradient = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size);
          gradient.addColorStop(0, `rgba(${p.color}, ${p.opacity * 0.8})`);
          gradient.addColorStop(0.5, `rgba(${p.color}, ${p.opacity * 0.3})`);
          gradient.addColorStop(1, `rgba(${p.color}, 0)`);
          ctx.beginPath();
          ctx.ellipse(p.x, p.y, p.size * 1.5, p.size * 0.6, Math.sin(time * 0.5) * 0.2, 0, Math.PI * 2);
          ctx.fillStyle = gradient;
          ctx.fill();
        }
      });

      requestAnimationFrame(animateSand);
    }

    resizeCanvas();
    createParticles();
    animateSand();

    window.addEventListener('resize', () => {
      resizeCanvas();
      createParticles();
    });
  }
</script>
