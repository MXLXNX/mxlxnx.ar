---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const content = {
  en: {
    credit: 'A Film Directed by Malena Posadas · Music Video for MODIS',
    debut: 'Directorial Debut · Currently on its 2026 festival run',
    logline: `A small fuzzy creature drifts through a strange, glowing world where the sun hasn't appeared in 10,000 days — carrying a quiet feeling it can't quite name.`,
    meta: '3:51 · Animation · Argentina · 2026',
    cta: 'Visit apieceofsun.com →'
  },
  es: {
    credit: 'Un Film Dirigido por Malena Posadas · Videoclip para MODIS',
    debut: 'Debut como Directora · Actualmente en su recorrido de festivales 2026',
    logline: `Una pequeña criatura peluda deambula por un mundo extraño y luminoso donde el sol no ha aparecido en 10.000 días — cargando un sentimiento tranquilo que no puede nombrar.`,
    meta: '3:51 · Animación · Argentina · 2026',
    cta: 'Visitá apieceofsun.com →'
  },
  fr: {
    credit: 'Un Film Réalisé par Malena Posadas · Clip Musical pour MODIS',
    debut: 'Premier Film comme Réalisatrice · Actuellement en tournée dans les festivals 2026',
    logline: `Une petite créature duveteuse dérive à travers un monde étrange et lumineux où le soleil n'est pas apparu depuis 10 000 jours — portant un sentiment discret qu'elle ne peut nommer.`,
    meta: '3:51 · Animation · Argentine · 2026',
    cta: 'Visitez apieceofsun.com →'
  },
  de: {
    credit: 'Ein Film unter der Regie von Malena Posadas · Musikvideo für MODIS',
    debut: 'Regiedebüt · Derzeit auf seiner Festivalrunde 2026',
    logline: `Eine kleine flauschige Kreatur treibt durch eine seltsame, leuchtende Welt, in der die Sonne seit 10.000 Tagen nicht mehr erschienen ist — mit einem stillen Gefühl, das sie nicht benennen kann.`,
    meta: '3:51 · Animation · Argentinien · 2026',
    cta: 'Besuchen Sie apieceofsun.com →'
  },
  pt: {
    credit: 'Um Filme Dirigido por Malena Posadas · Videoclipe para MODIS',
    debut: 'Estreia como Diretora · Atualmente em seu circuito de festivais 2026',
    logline: `Uma pequena criatura peluda vagueia por um mundo estranho e luminoso onde o sol não aparece há 10.000 dias — carregando um sentimento silencioso que não consegue nomear.`,
    meta: '3:51 · Animação · Argentina · 2026',
    cta: 'Visite apieceofsun.com →'
  },
  ja: {
    credit: 'マレナ・ポサダス監督作品 · MODISのミュージックビデオ',
    debut: '監督デビュー作 · 現在2026年の映画祭を巡回中',
    logline: `小さなふわふわの生き物が、太陽が10,000日間現れていない不思議で輝く世界を漂う — 名前の付けられない静かな気持ちを抱えながら。`,
    meta: '3:51 · アニメーション · アルゼンチン · 2026',
    cta: 'apieceofsun.com を訪問 →'
  },
  ar: {
    credit: 'فيلم من إخراج مالينا بوساداس · فيديو موسيقي لـ MODIS',
    debut: 'أول عمل إخراجي · حالياً في جولة مهرجانات 2026',
    logline: `مخلوق صغير كثيف الشعر يهيم في عالم غريب متلألئ حيث لم تظهر الشمس منذ 10,000 يوم — حاملاً شعوراً هادئاً لا يستطيع تسميته.`,
    meta: '3:51 · رسوم متحركة · الأرجنتين · 2026',
    cta: 'زر apieceofsun.com →'
  }
};

const t = content[lang as keyof typeof content] || content.en;
---

<section class="apos-section section" id="a-piece-of-sun">
  <div class="apos-section__hero">
    <picture class="apos-section__banner">
      <source media="(max-width: 767px)" srcset="/images/apieceofsun/banner-vertical.jpg" />
      <img src="/images/apieceofsun/banner-horizontal.jpg" alt="A Piece of Sun — a film by Malena Posadas" loading="lazy" />
    </picture>
    <div class="apos-section__hero-overlay">
      <span class="apos-section__eyebrow">{t.credit}</span>
      <h2 class="apos-section__title">A Piece of Sun</h2>
      <p class="apos-section__meta-top">{t.debut}</p>
    </div>
  </div>

  <div class="container apos-section__container">
    <p class="apos-section__logline">{t.logline}</p>
    <p class="apos-section__meta">{t.meta}</p>

    <div class="apos-section__video">
      <iframe
        src="https://www.youtube-nocookie.com/embed/QuHNFnwdg2g?rel=0&modestbranding=1&showinfo=0&iv_load_policy=3&playsinline=1"
        title="A Piece of Sun — MODIS"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>

    <div class="apos-section__cta">
      <a href="https://apieceofsun.com" target="_blank" rel="noopener" class="apos-section__link">{t.cta}</a>
    </div>
  </div>
</section>

<style>
  .apos-section {
    position: relative;
    background: #0a0a0a;
    overflow: hidden;
    padding: 0;
  }

  .apos-section__hero {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  @media (max-width: 767px) {
    .apos-section__hero {
      aspect-ratio: 9/16;
      max-height: 90vh;
    }
  }

  .apos-section__banner {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .apos-section__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .apos-section__hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(10,10,10,0) 30%,
      rgba(10,10,10,0.35) 55%,
      rgba(10,10,10,0.85) 80%,
      rgba(10,10,10,1) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .apos-section__hero-overlay {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 0 var(--space-lg) var(--space-2xl);
    text-align: center;
  }

  .apos-section__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.85);
    display: block;
    margin-bottom: var(--space-md);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
  }

  .apos-section__title {
    font-family: var(--font-accent);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 400;
    color: var(--color-white);
    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0 0 var(--space-md);
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.8);
  }

  .apos-section__meta-top {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
  }

  .apos-section__container {
    position: relative;
    z-index: 2;
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-4xl);
    text-align: center;
    max-width: 780px;
  }

  .apos-section__logline {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-gray-300);
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .apos-section__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gray-400);
    margin-bottom: var(--space-2xl);
  }

  .apos-section__video {
    max-width: 900px;
    margin: 0 auto var(--space-xl);
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16/9;
    box-shadow: 0 24px 60px rgba(0,0,0,0.6);
  }

  .apos-section__video iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .apos-section__cta {
    text-align: center;
  }

  .apos-section__link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-white);
    text-decoration: none;
    padding: var(--space-md) var(--space-xl);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: var(--radius-full);
    transition: all var(--transition-base);
  }

  .apos-section__link:hover {
    background: var(--color-white);
    color: var(--color-black);
    border-color: var(--color-white);
  }
</style>
