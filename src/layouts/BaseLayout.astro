---
import '../styles/global.css';
import '../styles/animations.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingElements from '../components/FloatingElements.astro';
import FloatingImages from '../components/FloatingImages.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const {
  title,
  description = "Creative portfolio showcasing design, video, and digital experiences.",
  image = "/images/og-image.jpg",
  lang = "en"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang={lang} class="is-loading">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title} | MXLXNX</title>
    <meta name="title" content={`${title} | MXLXNX`} />
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | MXLXNX`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | MXLXNX`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Fonts - Bold & Impactful -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Archivo+Black&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Preloader -->
    <div id="preloader" class="preloader" aria-hidden="true">
      <div class="preloader__blob"></div>
      <span class="preloader__text">MXLXNX</span>
    </div>

    <Header />
    <FloatingElements />
    <FloatingImages />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Scroll Animation Script -->
    <script>
      // Intersection Observer for scroll animations
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            // Optional: unobserve after animation
            // observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      // Observe all elements with data-animate attribute
      document.querySelectorAll('[data-animate]').forEach(el => {
        observer.observe(el);
      });

      // Observe stagger containers
      document.querySelectorAll('[data-stagger]').forEach(el => {
        observer.observe(el);
      });
    </script>

    <!-- Preloader Script -->
    <script>
      (function() {
        const preloader = document.getElementById('preloader');
        const html = document.documentElement;

        // Minimum display time for animation (2 seconds)
        const MIN_DISPLAY_TIME = 2000;
        const startTime = performance.now();

        // Hide preloader when fonts ready and minimum time passed
        async function hidePreloader() {
          // Wait for fonts
          await document.fonts.ready;

          // Calculate remaining time to meet minimum display
          const elapsed = performance.now() - startTime;
          const remainingTime = Math.max(0, MIN_DISPLAY_TIME - elapsed);

          // Wait for remaining time if needed
          if (remainingTime > 0) {
            await new Promise(resolve => setTimeout(resolve, remainingTime));
          }

          // Hide the preloader
          if (preloader) {
            preloader.classList.add('is-hidden');

            // Remove from DOM after transition
            preloader.addEventListener('transitionend', function handler() {
              preloader.removeEventListener('transitionend', handler);
              preloader.remove();
              html.classList.remove('is-loading');
            }, { once: true });

            // Fallback removal if transitionend doesn't fire
            setTimeout(() => {
              if (preloader.parentNode) {
                preloader.remove();
                html.classList.remove('is-loading');
              }
            }, 600);
          }
        }

        // Start hiding process
        hidePreloader();

        // Safety fallback - force hide after 5 seconds
        setTimeout(() => {
          if (preloader && preloader.parentNode) {
            preloader.remove();
            html.classList.remove('is-loading');
          }
        }, 5000);
      })();

      // Progressive image loading - fade in when loaded
      document.querySelectorAll('img[loading="lazy"]').forEach(img => {
        if (img.complete) {
          img.classList.add('is-loaded');
        } else {
          img.addEventListener('load', function() {
            this.classList.add('is-loaded');
          }, { once: true });
          img.addEventListener('error', function() {
            this.classList.add('is-loaded');
          }, { once: true });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Page transitions */
  main {
    min-height: 100vh;
  }
</style>
