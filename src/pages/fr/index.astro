---

<BaseLayout title="Accueil" lang="fr">
  <Hero name="Malena Posadas" title="MXLXNX" subtitle="Créative & Artiste Multidisciplinaire" />

  <VideoShowcase
    video="https://res.cloudinary.com/dbm9wua3c/video/upload/v1774130024/REEL_2026.mp4"
    title="Showreel"
    subtitle="Un aperçu de mon univers créatif"
    pastReels={[{ url: "https://res.cloudinary.com/dbm9wua3c/video/upload/v1764797670/REEL_jvojnq.mp4", type: "mp4" }]}
    pastReelsLabel="Voir les reels précédents"
    latestReelLabel="Retour au dernier reel"
  />

  <About lang="fr" />

  <section class="selected-works-header" id="selected-works">
    <div class="container">
      <h2 class="selected-works-title">Travaux Sélectionnés</h2>
    </div>
  </section>

  <VideoGrid videos={f1Videos} sectionTitle="F1 Visuals" sectionSubtitle="Visuels officiels pour Les Twins à la fête exclusive McLaren F1. Direction artistique, matériel IA et storytelling pour la diffusion en direct. Produit avec Flamboyant Paradise." featured={true} />
  <VideoGrid videos={meliVideos} sectionTitle="MERCADO LIBRE" sectionSubtitle="Publicité IA pour la plateforme e-commerce Mercado Libre. Projet d'équipe produit avec 1st Ave Machine." singleVideo={true} />
  <ProjectGrid projects={charactersProjects} lang="fr" sectionTitle="Personnages" sectionSubtitle="Je construis des personnages forts. Des personnalités qui vous captivent et ne vous lâchent plus." showFilters={false} variant="accent" />
  <ProjectGrid projects={moodsProjects} lang="fr" sectionTitle="Ambiances" sectionSubtitle="Latex, campagnes de mode, mondes néon et atmosphères visuelles que je conçois" showFilters={false} variant="accent" effect="flash" />

  <ProjectGrid projects={silentiaProjects} lang="fr" sectionTitle="SILENTIA" sectionSubtitle="Un monde visuel que j'ai créé — projet original de science-fiction co-écrit avec l'artiste Juan Penna. Scénario et look complets, recherche de financement." showFilters={false} effect="sand" />

  <Contact lang="fr" />
</BaseLayout>

<style>
  .selected-works-header { background: rgb(10, 10, 10); padding: var(--space-4xl) 0 var(--space-xl); text-align: center; position: relative; }
  .selected-works-title { font-family: var(--font-accent); font-size: var(--text-6xl); color: var(--color-white); letter-spacing: 0.1em; position: relative; display: inline-block; }
  .selected-works-title::after { content: ''; position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); width: 100px; height: 2px; background: var(--color-white); }
</style>
