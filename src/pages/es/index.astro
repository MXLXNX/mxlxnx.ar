---

<BaseLayout title="Inicio" lang="es">
  <Hero
    name="Malena Posadas"
    title="MXLXNX"
    subtitle="Creativa & Artista Multidisciplinaria"
  />

  <!-- Showreel -->
  <VideoShowcase
    video="/videos/REEL.mp4"
    title="Showreel"
    subtitle="Creo mundos con IA donde todo es posible — historias con alma, personajes con personalidad y universos visuales que se sienten vivos. Del concepto a la creación, empujo los límites de lo que se puede imaginar y construir."
  />

  <About lang="es" />

  <!-- Sección Trabajos Seleccionados -->
  <section class="selected-works-header" id="selected-works">
    <div class="container">
      <h2 class="selected-works-title">Trabajos Seleccionados</h2>
      <p class="selected-works-intro">Construyo mundos, creo personajes con alma y diseño universos visuales desde cero. Desde investigación profunda hasta ejecución final — dirección creativa, pitches, motion graphics y experiencias inmersivas.</p>
    </div>
  </section>

  <!-- F1 Visuals -->
  <VideoGrid
    videos={f1Videos}
    sectionTitle="F1 Visuals"
    sectionSubtitle="Visuales oficiales para Les Twins en la fiesta exclusiva de McLaren F1. Dirección de arte, material IA y storytelling para la transmisión en vivo. Producido con Flamboyant Paradise."
    featured={true}
  />

  <!-- MELI / Mercado Libre -->
  <VideoGrid
    videos={meliVideos}
    sectionTitle="MELI"
    sectionSubtitle="Comercial con IA para la plataforma de e-commerce Mercado Libre. Proyecto en equipo producido con 1st Ave Machine."
    singleVideo={true}
  />

  <!-- Personajes -->
  <ProjectGrid
    projects={charactersProjects}
    lang="es"
    sectionTitle="Personajes"
    sectionSubtitle="Diseño personajes con profundidad y personalidad — figuras que se sienten vivas, demandan atención y se quedan contigo. Cada rostro cuenta una historia, cada pose lleva intención."
    showFilters={false}
    variant="accent"
  />

  <!-- Moods -->
  <ProjectGrid
    projects={moodsProjects}
    lang="es"
    sectionTitle="Moods"
    sectionSubtitle="Mundos visuales inmersivos que investigo y diseño — desde moda futurista hasta atmósferas bañadas en neón. Cada pieza es un universo construido desde el concepto hasta el render final."
    showFilters={false}
    variant="accent"
    effect="flash"
  />

  <!-- SILENTIA -->
  <ProjectGrid
    projects={silentiaProjects}
    lang="es"
    sectionTitle="SILENTIA"
    sectionSubtitle="Un universo de ciencia ficción original que creé y desarrollé — world-building, identidad visual y guión completo co-escrito con el artista Juan Penna. Pitch deck totalmente realizado, listo para producción."
    showFilters={false}
    effect="sand"
  />

  <Contact lang="es" />
</BaseLayout>

<style>
  .selected-works-header {
    background: rgb(10, 10, 10);
    padding: var(--space-4xl) 0 var(--space-xl);
    text-align: center;
    position: relative;
  }

  .selected-works-title {
    font-family: var(--font-accent);
    font-size: var(--text-6xl);
    color: var(--color-white);
    letter-spacing: 0.1em;
    position: relative;
    display: inline-block;
  }

  .selected-works-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 2px;
    background: var(--color-white);
  }

  .selected-works-intro {
    max-width: 800px;
    margin: var(--space-2xl) auto 0;
    font-size: var(--text-lg);
    color: var(--color-gray-300);
    line-height: 1.7;
    text-align: center;
    position: relative;
  }
</style>
