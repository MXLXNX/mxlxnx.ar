---

<BaseLayout title="Home" lang="en">
  <Hero
    name="Malena Posadas"
    title="MXLXNX"
    subtitle="Creative & Multidisciplinary Artist"
    backgroundImage="/images/thelaundryman_Create_an_intense_futuristic_nightclub_scene_in_24ed272c-54dd-4c8f-ac37-c7c711bb28ed_2.png"
  />

  <!-- Showreel -->
  <VideoShowcase
    video="/videos/REEL.mp4"
    title="Showreel"
    subtitle="I craft AI-powered worlds where anything is possible — stories with soul, characters with personality, and visual universes that feel alive. From concept to creation, I push the boundaries of what can be imagined and built."
  />

  <!-- Selected Works Section -->
  <section class="selected-works-header" id="selected-works">
    <div class="container">
      <h2 class="selected-works-title">Selected Works</h2>
      <p class="selected-works-intro">I build worlds, craft characters with soul, and design visual universes from scratch. From deep research to final execution — creative direction, pitches, motion graphics, and immersive experiences.</p>
    </div>
  </section>

  <!-- F1 Visuals -->
  <VideoGrid
    videos={f1Videos}
    sectionTitle="F1 Visuals"
    sectionSubtitle="Official visuals for Les Twins performance at McLaren's exclusive F1 party. Full creative direction, motion design & real-time graphics for the live broadcast. Collaborated with production teams to deliver high-impact content for a global audience."
    featured={true}
  />

  <!-- MELI / Mercado Libre -->
  <VideoGrid
    videos={meliVideos}
    sectionTitle="MELI"
    sectionSubtitle="Commercial work for Mercado Libre"
    singleVideo={true}
  />

  <!-- Characters -->
  <ProjectGrid
    projects={charactersProjects}
    lang="en"
    sectionTitle="Characters"
    sectionSubtitle="I design characters with depth and personality — figures that feel alive, demand attention, and stay with you. Every face tells a story, every pose carries intention."
    showFilters={false}
    variant="accent"
  />

  <!-- Moods -->
  <ProjectGrid
    projects={moodsProjects}
    lang="en"
    sectionTitle="Moods"
    sectionSubtitle="Immersive visual worlds I research and design — from futuristic fashion to neon-drenched atmospheres. Each piece is a universe built from concept to final render."
    showFilters={false}
    variant="accent"
    effect="flash"
  />

  <!-- SILENTIA -->
  <ProjectGrid
    projects={silentiaProjects}
    lang="en"
    sectionTitle="SILENTIA"
    sectionSubtitle="An original sci-fi universe I created and developed — world-building, visual identity, and complete screenplay co-written with artist Juan Penna. A fully realized pitch deck ready for production."
    showFilters={false}
    effect="sand"
  />

  <About lang="en" />

  <Contact lang="en" />
</BaseLayout>

<style>
  .selected-works-header {
    background: var(--color-black);
    padding: var(--space-4xl) 0 var(--space-xl);
    text-align: center;
  }

  .selected-works-title {
    font-family: var(--font-accent);
    font-size: var(--text-6xl);
    color: var(--color-white);
    letter-spacing: 0.1em;
    position: relative;
    display: inline-block;
  }

  .selected-works-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 2px;
    background: var(--color-white);
  }

  .selected-works-intro {
    max-width: 800px;
    margin: var(--space-2xl) auto 0;
    font-size: var(--text-lg);
    color: var(--color-gray-300);
    line-height: 1.7;
    text-align: center;
  }
</style>
