---

<BaseLayout title="الرئيسية" lang="ar">
  <Hero name="مالينا بوساداس" title="MXLXNX" subtitle="مديرة إبداعية وفنانة متعددة التخصصات" />

  <VideoShowcase video="/videos/REEL.mp4" title="شوريل" subtitle="لمحة عن عالمي الإبداعي" />

  <About lang="ar" />

  <section class="selected-works-header" id="selected-works">
    <div class="container">
      <h2 class="selected-works-title">أعمال مختارة</h2>
    </div>
  </section>

  <VideoGrid videos={f1Videos} sectionTitle="F1 فيجوالز" sectionSubtitle="المرئيات الرسمية لـ Les Twins في حفلة McLaren F1 الحصرية. الإدارة الإبداعية والموشن ديزاين والرسومات الحية. إنتاج مع Flamboyant Paradise." featured={true} />
  <VideoGrid videos={meliVideos} sectionTitle="MELI" sectionSubtitle="إعلان معزز بالذكاء الاصطناعي لمنصة Mercado Libre. مشروع فريق مع 1st Ave Machine." singleVideo={true} />
  <ProjectGrid projects={charactersProjects} lang="ar" sectionTitle="الشخصيات" sectionSubtitle="أبني شخصيات قوية. شخصيات تأسرك ولا تتركك." showFilters={false} variant="accent" />
  <ProjectGrid projects={moodsProjects} lang="ar" sectionTitle="الأجواء" sectionSubtitle="اللاتكس، حملات الأزياء، عوالم النيون، والأجواء البصرية التي أصممها" showFilters={false} variant="accent" effect="flash" />

  <ProjectGrid projects={silentiaProjects} lang="ar" sectionTitle="SILENTIA" sectionSubtitle="عالم بصري أنشأته — مشروع خيال علمي أصلي كتب بالاشتراك مع الفنان خوان بينا. السيناريو والمظهر مكتملان، أبحث عن تمويل." showFilters={false} effect="sand" />

  <Contact lang="ar" />
</BaseLayout>

<style>
  .selected-works-header { background: linear-gradient(180deg, rgb(10, 10, 10) 0%, #12081a 30%, #180a1a 50%, #15081a 70%, rgb(10, 10, 10) 100%); padding: var(--space-4xl) 0 var(--space-xl); text-align: center; position: relative; }
  .selected-works-header::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 50%, rgba(200, 50, 255, 0.1) 0%, transparent 60%), radial-gradient(ellipse at 20% 30%, rgba(255, 100, 150, 0.08) 0%, transparent 40%), radial-gradient(ellipse at 80% 70%, rgba(100, 150, 255, 0.06) 0%, transparent 40%); pointer-events: none; }
  .selected-works-title { font-family: var(--font-accent); font-size: var(--text-6xl); color: var(--color-white); letter-spacing: 0.1em; position: relative; display: inline-block; }
  .selected-works-title::after { content: ''; position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); width: 100px; height: 2px; background: var(--color-white); }
</style>
