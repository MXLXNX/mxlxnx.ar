---

<BaseLayout title="Startseite" lang="de">
  <Hero name="Malena Posadas" title="MXLXNX" subtitle="Kreativdirektorin & Multidisziplinäre Künstlerin" backgroundImage="/images/thelaundryman_Create_an_intense_futuristic_nightclub_scene_in_24ed272c-54dd-4c8f-ac37-c7c711bb28ed_2.png" />

  <VideoShowcase video="/videos/REEL.mp4" title="Showreel" subtitle="Ein Einblick in mein kreatives Universum" />

  <section class="selected-works-header" id="selected-works">
    <div class="container">
      <h2 class="selected-works-title">Ausgewählte Arbeiten</h2>
    </div>
  </section>

  <VideoGrid videos={f1Videos} sectionTitle="F1 Visuals" sectionSubtitle="Visuals für Songs von Les Twins bei einer McLaren-Party — Ich habe alle Videos für die F1-Übertragung erstellt" featured={true} />
  <VideoGrid videos={meliVideos} sectionTitle="MELI" sectionSubtitle="Kommerzielle Arbeit für Mercado Libre" singleVideo={true} />
  <ProjectGrid projects={charactersProjects} lang="de" sectionTitle="Charaktere" sectionSubtitle="Ich erschaffe starke Charaktere. Persönlichkeiten, die dich packen und nicht mehr loslassen." showFilters={false} variant="accent" />
  <ProjectGrid projects={moodsProjects} lang="de" sectionTitle="Stimmungen" sectionSubtitle="Latex, Modekampagnen, Neonwelten und visuelle Atmosphären, die ich gestalte" showFilters={false} variant="accent" effect="flash" />
  <ProjectGrid projects={silentiaProjects} lang="de" sectionTitle="SILENTIA" sectionSubtitle="Eine visuelle Welt, die ich erschaffen habe — Original-Science-Fiction-Projekt, co-geschrieben mit dem Künstler Juan Penna. Drehbuch und Look fertig, suche Finanzierung." showFilters={false} effect="sand" />

  <About lang="de" />
  <Contact lang="de" />
</BaseLayout>

<style>
  .selected-works-header { background: var(--color-black); padding: var(--space-4xl) 0 var(--space-xl); text-align: center; }
  .selected-works-title { font-family: var(--font-accent); font-size: var(--text-6xl); color: var(--color-white); letter-spacing: 0.1em; position: relative; display: inline-block; }
  .selected-works-title::after { content: ''; position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); width: 100px; height: 2px; background: var(--color-white); }
</style>
